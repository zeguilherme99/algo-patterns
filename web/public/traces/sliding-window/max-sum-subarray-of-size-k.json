{
  "id" : "sliding-window/max-sum-subarray-of-size-k",
  "pattern" : "sliding-window",
  "title" : "Maximum Sum Subarray of Size K",
  "problem" : "Given an array of integers and a number k, find the maximum sum of any contiguous subarray of size k.",
  "snippet" : "int maxSum(int[] nums, int k) {\n    int sum = 0, best = Integer.MIN_VALUE;\n    for (int right = 0; right < nums.length; right++) {\n        sum += nums[right];                 // expand: add the new element\n        if (right >= k - 1) {               // window has k elements\n            best = Math.max(best, sum);     // record the answer\n            sum -= nums[right - k + 1];     // shrink: drop the leftmost\n        }\n    }\n    return best;\n}",
